{
  "name": "population-peaks",
  "version": "1.0.0",
  "private": true,
  "description": "Make 3D population spike maps of any country, state or city, and export Instagram-ready posters.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "fixture": "cd pipeline && .venv/bin/python -m pp_pipeline.fixture --out ../fixtures/data",
    "test:pipeline": "cd pipeline && .venv/bin/pytest",
    "build:fixture": "vite build && node scripts/copy-data.mjs fixtures/data dist/data",
    "pages": "node scripts/make-pages.ts dist",
    "previews": "node scripts/render-previews.ts --dist dist"
  },
  "dependencies": {
    "@fontsource-variable/sora": "5.3.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/three": "0.187.0",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
